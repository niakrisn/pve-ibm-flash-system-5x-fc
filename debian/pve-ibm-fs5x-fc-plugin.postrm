#!/bin/bash
set -e

APT_HOOK="/etc/apt/apt.conf.d/90-pve-ibm-fs5x-fc-plugin-hook"
STORAGE_PLUGIN="/usr/share/perl5/PVE/Storage/Custom/IBMFlashSystem.pm"

case "$1" in
    remove)
        # Fallback: try to remove patches if prerm didn't run or failed
        PATCH_MANAGER="/usr/share/pve-ibm-fs5x-fc-plugin/scripts/patch-manager.sh"
        if [ -x "$PATCH_MANAGER" ]; then
            "$PATCH_MANAGER" remove || true
        fi
        ;;

    purge)
        # Last resort: try patch-manager if still available
        PATCH_MANAGER="/usr/share/pve-ibm-fs5x-fc-plugin/scripts/patch-manager.sh"
        if [ -x "$PATCH_MANAGER" ]; then
            "$PATCH_MANAGER" remove || true
        fi

        # Remove APT hook
        if [ -f "$APT_HOOK" ]; then
            rm -f "$APT_HOOK"
            echo "Removed APT hook: $APT_HOOK"
        fi

        # Remove storage plugin
        if [ -f "$STORAGE_PLUGIN" ]; then
            rm -f "$STORAGE_PLUGIN"
            echo "Removed storage plugin: $STORAGE_PLUGIN"
            systemctl try-reload-or-restart pvedaemon pveproxy 2>/dev/null || true
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
