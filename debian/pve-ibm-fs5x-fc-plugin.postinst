#!/bin/bash
set -e

# Path to patch manager script
PATCH_MANAGER="/usr/share/pve-ibm-fs5x-fc-plugin/scripts/patch-manager.sh"

case "$1" in
    configure)
        # Ensure storage private directory exists (for tokens and secrets)
        # We handle this manually because pmxcfs (fuse) often rejects dpkg/chown operations
        if [ ! -d "/etc/pve/priv/storage" ]; then
            echo "Creating /etc/pve/priv/storage directory..."
            mkdir -p "/etc/pve/priv/storage" || true
            chmod 0700 "/etc/pve/priv/storage" || true
        fi

        # Make scripts executable
        SCRIPTS_DIR="/usr/share/pve-ibm-fs5x-fc-plugin/scripts"
        for script in patch-manager.sh apt-trigger.sh apt-post-invoke.sh; do
            if [ -f "$SCRIPTS_DIR/$script" ]; then
                chmod +x "$SCRIPTS_DIR/$script"
            fi
        done

        # Apply patches via patch manager
        if [ -x "$PATCH_MANAGER" ]; then
            "$PATCH_MANAGER" apply
        else
            echo "WARNING: Patch manager not found or not executable"
            echo "Patches will be applied by APT hook after installation."
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
