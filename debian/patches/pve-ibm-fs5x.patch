+++ PVE/API2/Qemu.pm	2026-01-06 10:11:20
@@ -4516,12 +4516,59 @@
             my $newvollist = [];
             my $jobs = {};
 
+            my $all_same_storage_offload = 0;
+            my @offload_volids = ();
+
             eval {
                 local $SIG{INT} = local $SIG{TERM} = local $SIG{QUIT} = local $SIG{HUP} =
                     sub { die "interrupted by signal\n"; };
 
-                PVE::Storage::activate_volumes($storecfg, $vollist, $snapname);
+                eval {
+                    local $SIG{INT} = local $SIG{TERM} = local $SIG{QUIT} = local $SIG{HUP} =
+                        sub { die "interrupted by signal\n"; };
 
+                    # Helper: check if volume has offload capability
+                    my $volume_has_offload = sub {
+                        my ($volid) = @_;
+                        my $features = PVE::Storage::volume_has_feature($storecfg, 'copy', $volid, $snapname, $running);
+                        return 0 unless $features && ref($features) eq 'HASH';
+                        my (undef, $volname) = PVE::Storage::parse_volume_id($volid);
+                        my $isBase = ($volname =~ m/^base-/) ? 1 : 0;
+                        my $key = $snapname ? 'snap' : ($isBase ? 'base' : 'current');
+                        return $features->{$key}->{offload} ? 1 : 0;
+                    };
+
+                    # Check: all sources on same storage with offload?
+                    $all_same_storage_offload = 1;
+                    my $first_storeid = undef;
+                    @offload_volids = ();
+
+                    foreach my $volid (@$vollist) {
+                        my ($storeid) = PVE::Storage::parse_volume_id($volid);
+                        $first_storeid //= $storeid;
+
+                        if ($storeid ne $first_storeid) {
+                            $all_same_storage_offload = 0;
+                        }
+
+                        if ($volume_has_offload->($volid)) {
+                            push @offload_volids, $volid;
+                        } else {
+                            $all_same_storage_offload = 0;
+                        }
+                    }
+
+                    # Rule 1: don't activate if all offload on same storage AND target is the same
+                    if ($storage && $first_storeid && $storage ne $first_storeid) {
+                        $all_same_storage_offload = 0;
+                    }
+
+                    unless ($all_same_storage_offload) {
+                        PVE::Storage::activate_volumes($storecfg, $vollist, $snapname);
+                    }
+                };
+                warn $@ if $@;
+
                 my $bwlimit = extract_param($param, 'bwlimit');
 
                 my $total_jobs = scalar(keys %{$drives});
@@ -4606,7 +4653,17 @@
 
                 PVE::AccessControl::add_vm_to_pool($newid, $pool) if $pool;
             };
-            if (my $err = $@) {
+            my $err = $@;
+
+            # Rule 2: deactivate offload volumes that were activated
+            if (!$all_same_storage_offload && !$running) {
+                foreach my $volid (@offload_volids) {
+                    eval { PVE::Storage::deactivate_volumes($storecfg, [$volid], $snapname); };
+                    warn "Deactivate failed for $volid: $@" if $@;
+                }
+            }
+
+            if ($err) {
                 eval { PVE::QemuServer::BlockJob::qemu_blockjobs_cancel($vmid, $jobs) };
