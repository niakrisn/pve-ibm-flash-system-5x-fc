#!/usr/bin/make -f

# Main build rule
%:
	dh $@

# No compilation needed for Perl plugin
override_dh_auto_build:
	# Nothing to build

# We don't need dh_auto_install because we use .install files
override_dh_auto_install:
	# Nothing to do here, dh_install will handle it

# We use .install files for each package, so dh_install works automatically
# override_dh_install is not needed as we want to keep filenames as is
