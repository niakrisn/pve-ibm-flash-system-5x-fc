/var/log/pve-storage-ibm.log {
    # Rotate log files daily
    daily

    # Keep 14 days of logs
    rotate 14

    # Don't rotate if log is empty
    notifempty

    # Delay compression by one rotation cycle
    delaycompress

    # Compress old logs with gzip
    compress

    # Use dateext for clearer naming (pve-storage-ibm.log-20251224)
    dateext

    # Date format for rotated files
    dateformat -%Y%m%d

    # Create new log file with secure permissions
    create 0640 root adm

    # Don't rotate if log file is missing
    missingok
}
