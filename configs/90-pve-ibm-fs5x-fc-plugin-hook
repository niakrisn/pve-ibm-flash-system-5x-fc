// APT hook for IBM FlashSystem 5.x FC Plugin
// Re-applies patches only when relevant PVE packages (qemu-server, pve-manager) are updated

// Pre-Install-Pkgs: Check if watched packages are being updated
DPkg::Pre-Install-Pkgs { "/usr/share/pve-ibm-fs5x-fc-plugin/scripts/apt-trigger.sh || true"; };

// Post-Invoke: Apply patches if needed (after dpkg completes)
DPkg::Post-Invoke { "/usr/share/pve-ibm-fs5x-fc-plugin/scripts/apt-post-invoke.sh || true"; };
